    groups: ["sudoless", "sudo", "adm"]
- authorized_key:
    user: "antero"
    key: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIK+I7t85Hjl87k9s9RAGIG+0MtgUoKKT1+05uA0edgGh m@m-virtualbox"
- copy:
    dest: "/etc/sudoers.d/sudoless"
    content: "%sudoless ALL = (ALL) NOPASSWD: ALL\n"
    owner: "root"
    group: "root"
    mode: "0644"
- apt:
    name: ["curl", "git"]
    state: present
